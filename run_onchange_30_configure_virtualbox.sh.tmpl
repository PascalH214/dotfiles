#!/bin/bash

source "{{ .chezmoi.sourceDir }}/lib/common.sh.tmpl"

{{ if .install_virtualbox -}}

print_section "Configuring VirtualBox"

# Add current user to vboxusers group
add_user_to_group "$USER" vboxusers

# Load VirtualBox kernel modules
echo -e "\n${BLUE}->${NC} Loading VirtualBox kernel modules..."
if command_exists modprobe; then
  echo -e "${BLUE}->${NC} Attempting to load vboxdrv module..."
  sudo modprobe vboxdrv 2>/dev/null && print_success "vboxdrv module loaded" || print_warning "Could not load vboxdrv (may already be loaded)"
fi

if command_exists systemctl; then
  # systemd-modules-load.service handles automatic loading at boot
  if systemctl is-active --quiet systemd-modules-load.service; then
    print_success "Kernel modules will be loaded automatically"
  else
    print_warning "systemd-modules-load.service is not active"
  fi
fi

echo -e "${BOLD}Next steps:${NC}"
echo -e "  1. Reboot or run: newgrp vboxusers (to apply group changes)"
echo -e "  2. Launch VirtualBox with: VirtualBox"
echo -e "  3. See the wiki: https://wiki.archlinux.org/title/VirtualBox\n"

{{ else -}}

print_section "VirtualBox: Not installed (skipped)"

{{ end -}}
