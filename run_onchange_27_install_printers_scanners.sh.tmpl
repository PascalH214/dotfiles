#!/bin/bash

source "{{ .chezmoi.sourceDir }}/lib/common.sh.tmpl"

{{ if or (eq .os "arch-linux") (eq .os "debian") -}}

{{ if .install_printers_scanners }}

{{ if eq .os "arch-linux" -}}
# Install CUPS for printing
install_yay_packages "CUPS (Printing)" cups cups-pdf cups-filters ghostscript gsfonts

# Install SANE and related packages for scanning
install_yay_packages "SANE (Scanning)" sane sane-airscan ipp-usb

# Optional GUI frontends for scanning
{{ if not .headless -}}
install_yay_packages "Scanner Frontends" simple-scan skanlite
{{- end }}
{{- else if eq .os "debian" -}}
# Install CUPS for printing (Debian)
install_apt_packages "CUPS (Printing)" cups cups-pdf cups-filters ghostscript

# Install SANE and related packages for scanning (Debian)
install_apt_packages "SANE (Scanning)" sane sane-airscan ipp-usb

# Optional GUI frontends for scanning
{{ if not .headless -}}
install_apt_packages "Scanner Frontends" simple-scan skanlite
{{- end }}
{{- end }}

{{ end -}}

{{ end -}}
