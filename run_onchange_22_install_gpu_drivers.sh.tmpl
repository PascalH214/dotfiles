#!/bin/bash

source "{{ .chezmoi.sourceDir }}/lib/common.sh.tmpl"

{{ if or (eq .os "arch-linux") (eq .os "debian") -}}

{{ if ne .gpu_vendor "none" -}}

print_section "GPU Drivers Installation"

{{ if eq .os "arch-linux" -}}
# Check if yay is available
if ! command_exists yay; then
  die "yay not installed"
fi
{{- else if eq .os "debian" -}}
# Check if apt is available
if ! command_exists apt; then
  die "apt not installed"
fi
{{- end }}

gpu_vendor="{{ .gpu_vendor }}"

case "$gpu_vendor" in
  amd)
    print_section "Installing AMD GPU Drivers"
    {{- if eq .os "arch-linux" }}
    yay -S --noconfirm --needed \
      xf86-video-amdgpu \
      vulkan-radeon \
      lib32-vulkan-radeon \
      libva-mesa-driver \
      lib32-libva-mesa-driver \
      mesa \
      lib32-mesa

    print_info "Installing AMD GPU management tools..."
    yay -S --noconfirm --needed \
      radeontop \
      rocm-opencl-runtime
    {{- else if eq .os "debian" }}
    sudo apt update
    sudo apt install -y \
      xserver-xorg-video-amdgpu \
      mesa-vulkan-drivers \
      libva-mesa-driver \
      mesa-va-drivers \
      mesa-utils

    print_info "Installing AMD GPU management tools..."
    sudo apt install -y radeontop
    {{- end }}
    print_success "AMD GPU drivers installed"
    ;;
  nvidia)
    print_section "Installing NVIDIA GPU Drivers"
    {{- if eq .os "arch-linux" }}
    yay -S --noconfirm --needed \
      nvidia \
      nvidia-utils \
      lib32-nvidia-utils \
      nvidia-dkms

    print_info "Installing NVIDIA additional tools..."
    yay -S --noconfirm --needed \
      cuda \
      cudnn
    {{- else if eq .os "debian" }}
    sudo apt update
    sudo apt install -y \
      nvidia-driver \
      nvidia-smi \
      nvidia-cuda-toolkit
    {{- end }}
    print_success "NVIDIA drivers installed"
    ;;
  intel)
    print_section "Installing Intel GPU Drivers"
    {{- if eq .os "arch-linux" }}
    yay -S --noconfirm --needed \
      intel-media-driver \
      libva-intel-driver \
      lib32-libva-intel-driver \
      vulkan-intel \
      lib32-vulkan-intel \
      mesa \
      lib32-mesa
    {{- else if eq .os "debian" }}
    sudo apt update
    sudo apt install -y \
      intel-media-va-driver \
      i965-va-driver \
      mesa-vulkan-drivers \
      mesa-utils
    {{- end }}
    print_success "Intel GPU drivers installed"
    ;;
  *)
    echo -e "${RED}error:${NC} Unknown GPU vendor: $gpu_vendor" >&2
    exit 1
    ;;
esac

{{- else }}

print_section "GPU Drivers Installation"
print_info "Skipping GPU drivers installation (not configured)"

{{- end }}

{{ end -}}
